#include <stdio.h>
#include <ctype.h>
int main(){
    char str[100];
    int i, count = 0;
    printf("enter string: ");
    gets(str);
    for (i = 0; str[i] != '\0'; i++) {
        char ch = tolower(str[i]);
        if (ch >= 'a' && ch <= 'z' &&
            ch != 'a' && ch != 'e' && ch != 'i' && ch != 'o' && ch != 'u') {
            count++;
        }
    }
    printf("consonants: %d", count);
    return 0;
}
