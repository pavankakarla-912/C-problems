#include <stdio.h>
int factorial(int n)
{
    int fact = 1;
    for(int i = 1;i<=n;i++){
        fact=fact * i;
    }
    return fact;
}
int main()
{
    int num,temp,digit,sum = 0;
    printf("enter a number: ");
    scanf("%d",&num);
    temp = num;
    while(temp > 0){
        digit = temp % 10;
        sum = sum+factorial(digit);
        temp = temp / 10;
    }
    if(sum == num)
    {
        printf("strong Number");
    }
    else{
        printf("not a Strong Number");
    }
    return 0;
}
