#include <stdio.h>
int main() 
{
    int n;
    int i;
    printf("enter number of elements: ");
    scanf("%d",&n);
    int arr[n];
    printf("enter elements:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    int largest = arr[0], second = -1;
    for(i = 1; i < n; i++) {
        if(arr[i] > largest) {
            second = largest;
            largest = arr[i];
        }
        else if(arr[i] > second && arr[i] != largest) {
            second = arr[i];
        }
    }
    printf("second largest = %d\n", second);
    return 0;
}
